# Required for paid mode
PAY_TO_ADDRESS=0xYourPayoutWallet
# Pin this or every signature breaks on each deploy. Generate with: npm run keygen
SIGNING_KEY_PKCS8_B64=
# Coinbase CDP facilitator (also what gets you into the Bazaar catalog)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Second billing rail: key:label:monthlyQuota, comma separated.
# This is how buyers who will never hold USDC actually pay you.
API_KEYS=rk_live_example:acme-customs:5000
X402_NETWORK=eip155:8453
